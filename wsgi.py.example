"""Copy the relevant lines into the PythonAnywhere WSGI configuration file."""

import os
import sys

project_home = "/home/nkprs/birthday-quiz"
if project_home not in sys.path:
    sys.path.insert(0, project_home)

# PythonAnywhere web apps do not automatically inherit variables exported in a
# Bash console. Set them here, or use the Web tab's environment-variable UI if
# it is available for your account. Never commit the real values.
os.environ["FLASK_SECRET_KEY"] = "PASTE-A-LONG-RANDOM-SECRET-HERE"
os.environ["ADMIN_PASSWORD"] = "PASTE-A-STRONG-ADMIN-PASSWORD-HERE"
os.environ["QUIZ_DATABASE"] = "/home/nkprs/quiz-data/quiz.sqlite"
os.environ["QUIZ_CONFIG"] = "/home/nkprs/birthday-quiz/config/quiz.json"
os.environ["SESSION_COOKIE_SECURE"] = "true"

from app import create_app

application = create_app()

